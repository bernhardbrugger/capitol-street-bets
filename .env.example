# Copy to .env and fill in. Never commit .env.
# Free key: https://www.alphavantage.co/support/#api-key

ALPHAVANTAGE_API_KEY=

# Plan limits. The client also reads throttle messages from Alpha Vantage
# and stores whatever per-minute / per-day numbers the response states.
# Premium plans have no daily cap: set AV_REQUESTS_PER_DAY=0 and the
# per-minute value from your plan (75, 150, 300, 600, or 1200).
AV_REQUESTS_PER_MINUTE=5
AV_REQUESTS_PER_DAY=25

# TIME_SERIES_DAILY is on the free plan (raw closes).
# TIME_SERIES_DAILY_ADJUSTED is premium. outputsize=full is premium;
# compact is the latest 100 sessions and is merged into the local cache.
AV_PRICE_FUNCTION=TIME_SERIES_DAILY
AV_OUTPUTSIZE=compact

# Share of a finite daily budget spent on prices. The rest, minus one
# metadata slot when the roster is stale, refreshes the next members.
AV_PRICE_BUDGET_SHARE=0.35

# Safety cap for a single run when the daily budget is unlimited.
AV_MAX_REQUESTS_PER_RUN=8000

# Ranked members need at least this many priced equity trades in the window.
AV_MIN_TRADES=3

# STOCK Act public shorthand used by this project. Filings later than this
# many days after the transaction are flagged late.
AV_LATE_DAYS=45

# Discovery: one CONGRESS_TRADES call per symbol shows which members actually
# trade, so those are fetched first. Refreshed every 30 days. Empty = off.
AV_DISCOVERY_SYMBOLS=NVDA,MSFT,AAPL,AMZN,GOOGL,META,TSLA,AVGO
